<div>
  <a class="small-mono" href="<%= url_for('/streams') %>">&larr; Back to streams</a>
</div>

<div class="kpis">
  <div class="kpi" style="--hue:var(--c1)"><div class="kpi-label"><i></i>Messages</div><div class="kpi-val"><b><%= format_numbers(@state.messages) %></b></div></div>
  <div class="kpi" style="--hue:var(--c2)"><div class="kpi-label"><i></i>Size</div><div class="kpi-val"><b><%= format_bytes(@state.bytes) %></b></div></div>
  <div class="kpi" style="--hue:var(--c3)"><div class="kpi-label"><i></i>Consumers</div><div class="kpi-val"><b><%= @state.consumer_count %></b></div></div>
  <div class="kpi" style="--hue:var(--c4)"><div class="kpi-label"><i></i>Sequence range</div><div class="kpi-val"><b style="font-size:22px"><%= format_numbers(@state.first_seq) %> → <%= format_numbers(@state.last_seq) %></b></div></div>
</div>

<%= render('streams/_pause_banner', { name: @name, paused: @paused }) %>

<section class="card">
  <div class="card-head bar ruled"><div class="card-title">Configuration</div></div>
  <% rows = {
       'Name' => @name,
       'Retention' => @config.retention,
       'Storage' => @config.storage,
       'Replicas' => @config.num_replicas || 1,
       'Discard policy' => @config.discard,
       'Max consumers' => @config.max_consumers.to_i.positive? ? @config.max_consumers : 'Unlimited',
       'Max messages' => @config.max_msgs.to_i.positive? ? format_numbers(@config.max_msgs) : 'Unlimited',
       'Max bytes' => @config.max_bytes.to_i.positive? ? format_bytes(@config.max_bytes) : 'Unlimited',
       'Max age' => @config.max_age.to_i.positive? ? "#{format_span(@config.max_age.to_i / 1_000_000_000)} (#{@config.max_age}ns)" : 'Unlimited'
     } -%>
  <% rows.each do |label, value| -%>
    <div class="trow t-kv"><span class="eyebrow"><%= label %></span><code><%= h(value) %></code></div>
  <% end -%>
  <div class="trow t-kv">
    <span class="eyebrow">Subjects</span>
    <div class="subjects"><% Array(@config.subjects).each do |subject| -%><span class="subject"><%= h(subject) %></span><% end -%></div>
  </div>
</section>
