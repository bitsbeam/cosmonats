<section class="card card-pad grow2" id="throughput"
         hx-get="<%= url_for('/_throughput', days: @days) %>" hx-trigger="cosmo:poll" data-poll="30" hx-swap="outerHTML">
  <div class="card-head">
    <div class="card-title">Throughput</div>
    <div class="legend"><i></i>succeeded / day</div>
    <div class="legend"><i class="fail"></i>failed</div>
    <div class="seg">
      <% @ranges.each do |range| -%>
        <button type="button" class="<%= 'on' if range == @days %>" hx-get="<%= url_for('/_throughput', days: range) %>"
                hx-target="#throughput" hx-swap="outerHTML" hx-indicator="#global-spinner"><%= range %>d</button>
      <% end -%>
    </div>
  </div>
  <% if @chart.empty? -%>
    <div class="empty"><b>No runs yet</b>Nothing recorded in the last <%= @days %> days.</div>
  <% else -%>
    <div class="chart">
      <div class="yaxis"><% @chart.ticks.each do |tick| -%><span><%= compact_number(tick) %></span><% end -%></div>
      <div class="plot-col">
        <div class="plot">
          <svg viewBox="0 0 <%= Cosmo::Web::Throughput::WIDTH %> <%= Cosmo::Web::Throughput::HEIGHT %>" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="thrFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--c2)" stop-opacity="0.22"/><stop offset="1" stop-color="var(--c1)" stop-opacity="0"/></linearGradient>
              <linearGradient id="thrLine" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="var(--c3)"/><stop offset="0.55" stop-color="var(--c1)"/><stop offset="1" stop-color="var(--c2)"/></linearGradient>
              <linearGradient id="thrFail" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--err)" stop-opacity="0.95"/><stop offset="1" stop-color="var(--err)" stop-opacity="0.45"/></linearGradient>
            </defs>
            <path d="<%= @chart.grid %>" stroke="var(--line)" stroke-width="1" vector-effect="non-scaling-stroke" fill="none"/>
            <path d="<%= @chart.area %>" fill="url(#thrFill)"/>
            <path d="<%= @chart.line %>" stroke="url(#thrLine)" stroke-width="1.75" vector-effect="non-scaling-stroke" fill="none" stroke-linejoin="round"/>
            <path d="<%= @chart.failures %>" fill="url(#thrFail)"/>
          </svg>
          <% @chart.points.each do |point| -%>
            <div class="hit<%= ' flip' if point[:center] > 62 %>" style="left:<%= point[:left] %>%;width:<%= point[:width] %>%">
              <div class="hv-line"></div>
              <div class="hv-dot" style="top:<%= point[:top] %>%"></div>
              <div class="tip">
                <span class="mono mute" style="font-size:10.5px"><%= point[:label] %></span>
                <div><span class="mute">succeeded</span><span class="num"><%= format_numbers(point[:count]) %></span></div>
                <div><span class="mute">failed</span><span class="num" style="color:var(--err)"><%= format_numbers(point[:failed]) %></span></div>
                <div><span class="mute">avg exec</span><span class="num"><%= duration(point[:exec_ms]) %></span></div>
                <div><span class="mute">avg wait</span><span class="num"><%= duration(point[:wait_ms]) %></span></div>
              </div>
            </div>
          <% end -%>
        </div>
        <div class="xaxis"><% @chart.labels.each do |label| -%><span><%= label %></span><% end -%></div>
      </div>
    </div>
  <% end -%>
</section>
