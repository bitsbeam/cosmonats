<div id="dead-jobs">
  <% if @jobs.empty? -%>
    <div class="alert alert-success">No dead jobs found</div>
  <% else -%>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>Job</th>
            <th>JID[Args]</th>
            <th>Stream</th>
            <th>Error</th>
            <th>Failed</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @jobs.each do |job| -%>
          <tr class="dead-row" id="dead-row-<%= job.seq %>">
            <td>
              <div class="job-class">
                <%= h(job.data[:class].to_s) %>
              </div>
            </td>
            <td>
              <div class="job-id">
                <details>
                  <summary>
                    <code><%= h(job.data[:jid].to_s) %></code>
                  </summary>
                  <code><%= h((JSON.pretty_generate(job.data[:args]) rescue job.data[:args].to_s)) %></code>
                </details>
              </div>
            </td>
            <td style="white-space: nowrap;">
              <% if job.x_stream -%><code><%= h(job.x_stream) %></code><% else -%><span class="text-muted">&mdash;</span><% end -%>
            </td>
            <td style="min-width: 420px;">
              <% if job.error? -%>
              <div class="error-message">
                <strong><%= h(job.error_class.to_s.empty? ? "Error" : job.error_class) %></strong>
                <p><%= h(job.error_message) %></p>
                <% if job.error_backtrace -%>
                <details>
                  <summary>Backtrace</summary>
                  <code><%= h(job.error_backtrace_lines.join("\n")) %></code>
                </details>
                <% end -%>
              </div>
              <% else -%>
              <div class="error-message">
                <strong>Unknown</strong>
                <p>No error recorded for this job</p>
              </div>
              <% end -%>
            </td>
            <td style="white-space: nowrap;">
              <% if (failed_at = job.stored_at) -%>
              <time datetime="<%= h(job.timestamp) %>" title="<%= h(job.timestamp) %>"><%= h(format_timestamp(failed_at)) %></time>
              <div class="text-muted" style="font-size: var(--font-size-small);"><%= elapsed(failed_at) %> ago</div>
              <% else -%>
              <span class="text-muted">&mdash;</span>
              <% end -%>
            </td>
            <td style="white-space: nowrap;">
              <a hx-patch="<%= url_for("/jobs/retry/#{job.seq}") %>"
                 hx-target="#dead-row-<%= job.seq %>"
                 hx-swap="innerHTML"
                 title="Retry"
                 class="btn btn-primary btn-sm">&#x21BB;</a>
              <a hx-delete="<%= url_for("/jobs/delete/#{job.seq}") %>"
                 hx-target="#dead-row-<%= job.seq %>"
                 hx-swap="innerHTML"
                 title="Delete"
                 class="btn btn-danger btn-sm">&#x2715;</a>
            </td>
          </tr>
          <% end -%>
        </tbody>
      </table>
    </div>
  <% end -%>
</div>
