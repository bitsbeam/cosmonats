<% if @jobs.empty? -%>
  <div class="empty"><b>No dead jobs</b>Nothing has given up.</div>
<% else -%>
  <div class="scroll"><div style="min-width:860px">
    <div class="thead t-jobs actions"><span>JID</span><span>Class</span><span>Args</span><span>Queue</span><span>Status</span><span class="r">Failed</span><span></span></div>
    <% @jobs.each do |job| -%>
      <div class="trow hover t-jobs actions">
        <span class="mono mute ellip" style="font-size:11.5px" title="<%= h(job.data[:jid]) %>"><%= h(job.data[:jid]) %></span>
        <span class="strong ellip"><%= h(job.data[:class]) %></span>
        <%= render('jobs/_args', { args: job.data[:args] }) %>
        <span class="mono ellip" style="font-size:12px"><%= job.x_stream ? h(job.x_stream) : '—' %></span>
        <span class="pill" style="--tone:var(--err)">dead</span>
        <% if (failed_at = job.stored_at) -%>
          <span class="mono mute r" style="font-size:11.5px" title="<%= h(format_timestamp(failed_at)) %>"><%= elapsed(failed_at) %> ago</span>
        <% else -%>
          <span class="mono mute r">—</span>
        <% end -%>
        <div class="btns">
          <button type="button" class="btn" title="Retry"
                  hx-patch="<%= url_for("/jobs/retry/#{job.seq}") %>" hx-target="closest .trow" hx-swap="outerHTML"
                  hx-indicator="#global-spinner">↻</button>
          <button type="button" class="btn danger" title="Delete"
                  hx-delete="<%= url_for("/jobs/delete/#{job.seq}") %>" hx-target="closest .trow" hx-swap="outerHTML"
                  hx-indicator="#global-spinner" hx-confirm="Delete dead job #<%= job.seq %>?">✕</button>
        </div>
        <div class="full error-line">
          <% if job.error? -%>
            <b><%= h(job.error_class.to_s.empty? ? 'Error' : job.error_class) %></b>
            <span><%= h(job.error_message) %></span>
            <% if job.error_backtrace -%>
              <details>
                <summary class="small-mono">Backtrace</summary>
                <pre class="code-block"><%= h(job.error_backtrace_lines.join("\n")) %></pre>
              </details>
            <% end -%>
          <% else -%>
            <b>Unknown</b><span class="mute">No error recorded for this job</span>
          <% end -%>
        </div>
      </div>
    <% end -%>
  </div></div>
<% end -%>
