<% if @jobs.empty? -%>
  <div class="empty"><b>All quiet</b>No jobs are running right now.</div>
<% else -%>
  <div class="scroll"><div style="min-width:860px">
    <div class="thead t-jobs"><span>JID</span><span>Class</span><span>Args</span><span>Queue</span><span>Status</span><span class="r">Try</span><span class="r">Running for</span></div>
    <% @jobs.each do |job| -%>
      <% delivery = job[:delivery].to_i -%>
      <% retries = job.dig(:data, :retry) -%>
      <div class="trow hover t-jobs">
        <span class="mono mute ellip" style="font-size:11.5px" title="<%= h(job.dig(:data, :jid)) %>"><%= h(job.dig(:data, :jid)) %></span>
        <div class="stack">
          <span class="strong ellip"><%= h(job.dig(:data, :class)) %></span>
          <span class="small-mono ellip" title="<%= h(job[:worker]) %>"><%= h(job[:worker]) %></span>
        </div>
        <%= render('jobs/_args', { args: job.dig(:data, :args) }) %>
        <span class="mono ellip" style="font-size:12px"><%= h(job[:stream]) %></span>
        <span class="pill" style="--tone:var(--acc)">running</span>
        <span class="mono r" style="font-size:12px;color:<%= delivery >= 5 ? 'var(--err)' : delivery > 1 ? 'var(--warn)' : 'var(--mute)' %>">
          <%= delivery.zero? ? '—' : delivery %><%= "/#{retries.to_i + 1}" if retries.is_a?(Integer) && delivery.positive? %>
        </span>
        <span class="mono mute r" style="font-size:11.5px"><%= elapsed(job[:started_at]) %></span>
      </div>
    <% end -%>
  </div></div>
<% end -%>
