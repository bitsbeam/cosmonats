<% grid = @compact ? 't-queues' : 't-queues-full' -%>
<% if @compact -%>
  <div class="card-head bar">
    <div class="card-title">Streams</div>
    <a class="small-mono" href="<%= url_for('/jobs') %>">All streams &rarr;</a>
  </div>
<% end -%>
<% if @queues.empty? -%>
  <div class="empty"><b>No job streams</b>Run <code>cosmo --setup</code> to create them.</div>
<% else -%>
  <div class="scroll"><div style="min-width:<%= @compact ? 520 : 680 %>px">
    <div class="thead<%= ' top' if @compact %> <%= grid %>">
      <span>Stream</span><span class="r">Size</span><span class="r">Busy</span><span class="r">Retries</span>
      <% if @compact -%><span></span><% else -%><span>Status</span><span></span><% end -%>
    </div>
    <% @queues.each do |queue| -%>
      <%= render('jobs/_queue_row', { queue:, compact: @compact }) %>
    <% end -%>
  </div></div>
<% end -%>
