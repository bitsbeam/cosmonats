<% if @jobs.empty? -%>
  <div class="empty"><b>Nothing scheduled</b>No delayed jobs are waiting for their time.</div>
<% else -%>
  <div class="scroll"><div style="min-width:820px">
    <div class="thead t-jobs plain"><span>JID</span><span>Class</span><span>Args</span><span>Queue</span><span>Status</span><span class="r">When</span></div>
    <% @jobs.each do |job| -%>
      <div class="trow hover t-jobs plain">
        <span class="mono mute ellip" style="font-size:11.5px" title="<%= h(job.data[:jid]) %>"><%= h(job.data[:jid]) %></span>
        <span class="strong ellip"><%= h(job.data[:class]) %></span>
        <%= render('jobs/_args', { args: job.data[:args] }) %>
        <span class="mono ellip" style="font-size:12px"><%= h(job.x_stream) %></span>
        <span class="pill" style="--tone:var(--warn)">scheduled</span>
        <div class="stack r" style="text-align:right">
          <span class="mono" style="font-size:12px"><%= h(time_until(job.execute_at)) %></span>
          <span class="small-mono"><%= h(format_timestamp(job.execute_at)) %></span>
        </div>
      </div>
    <% end -%>
  </div></div>
<% end -%>
