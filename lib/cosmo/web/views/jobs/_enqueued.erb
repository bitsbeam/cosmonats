<% purge_note = "Purged jobs are lost: they are not retried or sent to the dead stream.\nJobs already running keep going, but a failed one can no longer be retried.\nA batch waiting on purged jobs never fires its callbacks." -%>
<div class="subbar">
  <div class="seg">
    <% @stream_sizes.each do |name, size| -%>
      <a class="<%= 'on' if @stream_name.to_s == name.to_s %>" href="<%= url_for('/jobs/enqueued', stream_name: u(name)) %>"
         hx-get="<%= url_for('/jobs/enqueued', stream_name: u(name)) %>" hx-target="#jobs-panel" hx-swap="outerHTML"
         hx-push-url="true" hx-indicator="#global-spinner"><%= h(name) %><span class="<%= 'has' if size.positive? %>"><%= compact_number(size) %></span></a>
    <% end -%>
  </div>
  <span class="spacer"></span>
  <span class="small-mono"><%= format_numbers(@total.to_i) %> message(s) pending</span>
  <% if @total.to_i.positive? -%>
    <button type="button" class="btn danger" title="Remove every pending job from this stream"
            hx-delete="<%= url_for('/jobs/enqueued/purge', stream_name: u(@stream_name)) %>"
            hx-target="#jobs-panel" hx-swap="outerHTML" hx-indicator="#global-spinner"
            hx-confirm="<%= h("Purge all #{format_numbers(@total.to_i)} pending jobs from #{@stream_name}?\n\n#{purge_note}") %>">Purge all</button>
  <% end -%>
</div>
<% if @jobs.nil? -%>
  <div class="empty"><b>No job streams</b>Run <code>cosmo --setup</code> to create them.</div>
<% elsif @jobs.empty? -%>
  <div class="empty"><b>Queue is empty</b><code><%= h(@stream_name) %></code> has nothing waiting.</div>
<% else -%>
  <div class="scroll"><div style="min-width:860px">
    <div class="thead t-jobs actions"><span>JID</span><span>Class</span><span>Args</span><span>Seq</span><span class="r">Enqueued</span><span></span></div>
    <% @jobs.each do |job| -%>
      <div class="trow hover t-jobs actions">
        <%= jid_cell(job.data, stream: @stream_name) %>
        <span class="strong ellip"><%= h(job.data[:class]) %></span>
        <%= render('jobs/_args', { args: job.data[:args] }) %>
        <span class="mono mute" style="font-size:12px">#<%= job.seq %></span>
        <span class="mono mute r" style="font-size:11.5px"><%= (at = job.stored_at) ? "#{elapsed(at)} ago" : '—' %></span>
        <div class="btns">
          <button type="button" class="btn danger" title="Remove message"
                  hx-delete="<%= url_for("/jobs/enqueued/#{job.seq}", { stream_name: u(@stream_name), after: @after, limit: @limit }.compact) %>"
                  hx-target="#jobs-panel" hx-swap="outerHTML" hx-indicator="#global-spinner"
                  hx-confirm="Remove message #<%= job.seq %> from <%= h(@stream_name) %>?">✕</button>
          <button type="button" class="btn danger" title="Purge every pending <%= h(job.data[:class]) %>"
                  hx-delete="<%= url_for('/jobs/enqueued/purge', { stream_name: u(@stream_name), class: u(Cosmo::Utils::String.underscore(job.data[:class])) }) %>"
                  hx-target="#jobs-panel" hx-swap="outerHTML" hx-indicator="#global-spinner"
                  hx-confirm="<%= h("Purge every pending #{job.data[:class]} from #{@stream_name}?\n\n#{purge_note}") %>">✕✕</button>
        </div>
      </div>
    <% end -%>
  </div></div>
<% end -%>
