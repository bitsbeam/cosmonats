<div class="subbar">
  <div class="seg">
    <% @stream_names.each do |name| -%>
      <a class="<%= 'on' if @stream_name.to_s == name.to_s %>" href="<%= url_for('/jobs/enqueued', stream_name: u(name)) %>"
         hx-get="<%= url_for('/jobs/enqueued', stream_name: u(name)) %>" hx-target="#jobs-panel" hx-swap="outerHTML"
         hx-push-url="true" hx-indicator="#global-spinner"><%= h(name) %></a>
    <% end -%>
  </div>
  <span class="spacer"></span>
  <span class="small-mono"><%= format_numbers(@total.to_i) %> message(s) pending</span>
</div>
<% if @jobs.nil? -%>
  <div class="empty"><b>No job streams</b>Run <code>cosmo --setup</code> to create them.</div>
<% elsif @jobs.empty? -%>
  <div class="empty"><b>Queue is empty</b><code><%= h(@stream_name) %></code> has nothing waiting.</div>
<% else -%>
  <div class="scroll"><div style="min-width:860px">
    <div class="thead t-jobs actions"><span>JID</span><span>Class</span><span>Args</span><span>Seq</span><span>Status</span><span class="r">Enqueued</span><span></span></div>
    <% @jobs.each do |job| -%>
      <div class="trow hover t-jobs actions">
        <span class="mono mute ellip" style="font-size:11.5px" title="<%= h(job.data[:jid]) %>"><%= h(job.data[:jid]) %></span>
        <span class="strong ellip"><%= h(job.data[:class]) %></span>
        <%= render('jobs/_args', { args: job.data[:args] }) %>
        <span class="mono mute" style="font-size:12px">#<%= job.seq %></span>
        <span class="pill" style="--tone:var(--mute)">enqueued</span>
        <span class="mono mute r" style="font-size:11.5px"><%= (at = job.stored_at) ? "#{elapsed(at)} ago" : '—' %></span>
        <div class="btns">
          <button type="button" class="btn danger" title="Remove message"
                  hx-delete="<%= url_for("/jobs/enqueued/#{job.seq}", { stream_name: u(@stream_name), page: @page, limit: @limit }) %>"
                  hx-target="#jobs-panel" hx-swap="outerHTML" hx-indicator="#global-spinner"
                  hx-confirm="Remove message #<%= job.seq %> from <%= h(@stream_name) %>?">✕</button>
        </div>
      </div>
    <% end -%>
  </div></div>
<% end -%>
