<% if @batches.empty? -%>
  <section class="card"><div class="empty"><b>No batches tracked</b>Group jobs with <code>Cosmo::Batch.new.jobs { … }</code>.</div></section>
<% else -%>
  <div class="batches">
    <% @batches.each do |b| -%>
      <% stats = b.stats -%>
      <% total = stats[:total].to_i -%>
      <% succeeded = stats[:succeeded].to_i -%>
      <% failed = stats[:failed].to_i -%>
      <% done = total - stats[:pending].to_i -%>
      <% status, tone = if !b.ready? then ['open', 'var(--acc)'] elsif failed.positive? then ['complete with failures', 'var(--warn)'] else ['success', 'var(--ok)'] end -%>
      <% callbacks = b.callbacks.compact -%>
      <section class="card batch">
        <div class="batch-top">
          <div class="stack" style="flex:1;gap:4px">
            <div class="mono strong ellip"><%= h(b.bid) %></div>
            <div class="small-mono ellip">
              <% if b.parent_id -%>parent <%= h(b.parent_id) %> · <% end -%>started <%= b.created_at ? "#{elapsed(b.created_at)} ago" : '—' %>
            </div>
          </div>
          <span class="pill" style="--tone:<%= tone %>"><%= status %></span>
        </div>
        <div class="batch-pct">
          <b><%= total.positive? ? (done * 100 / total).clamp(0, 100) : 0 %>%</b>
          <span class="mono mute" style="font-size:11.5px"><%= compact_number(done) %> / <%= compact_number(total) %></span>
        </div>
        <div class="progress">
          <% if total.positive? -%>
            <i style="width:<%= (succeeded * 100.0 / total).round(2) %>%;background:<%= hue(b.bid) %>"></i>
            <% if failed.positive? -%><i style="width:<%= [failed * 100.0 / total, 0.6].max.round(2) %>%;background:var(--err)"></i><% end -%>
          <% end -%>
        </div>
        <div class="batch-foot">
          <span><span class="num" style="color:var(--ink)"><%= format_numbers(succeeded) %></span> succeeded</span>
          <span><span class="num" style="color:var(--err)"><%= format_numbers(failed) %></span> failed</span>
          <span><span class="num" style="color:var(--ink)"><%= format_numbers(stats[:pending]) %></span> pending</span>
          <% if callbacks.any? -%>
            <span class="cb">
              <% callbacks.each do |event, callback| -%><span>on_<%= event %> → <%= h(callback[:class]) %></span><% end -%>
            </span>
          <% end -%>
        </div>
      </section>
    <% end -%>
  </div>
<% end -%>
