<div id="batches-panel" hx-get="<%= url_for('/batches/_table', @query.merge(@cursor)) %>" hx-trigger="cosmo:poll" data-poll="<%= poll_interval %>" hx-swap="outerHTML">
<div class="seg batch-view">
  <% { 'cards' => '▦ Cards', 'table' => '☰ Table' }.each do |mode, label| -%>
    <a class="<%= 'on' if mode == @view %>" href="<%= url_for('/batches', { view: mode }) %>"><%= label %></a>
  <% end -%>
</div>
<% if @page.batches.empty? -%>
  <section class="card"><div class="empty"><b>No batches tracked</b>Group jobs with <code>Cosmo::Batch.new.jobs { … }</code>.</div></section>
<% elsif @view == 'table' -%>
  <section class="card"><div class="scroll"><div style="min-width:760px">
    <div class="thead t-batches"><span>Batch</span><span>Status</span><span>Progress</span><span>Succeeded</span><span>Failed</span><span>Pending</span><span>Started</span></div>
    <% @page.batches.each do |b| -%>
      <% stats = b.stats -%>
      <% total = stats[:total].to_i -%>
      <% failed = stats[:failed].to_i -%>
      <% done = total - stats[:pending].to_i -%>
      <% status, tone = if !b.ready? then ['open', 'var(--acc)'] elsif failed.positive? then ['failed', 'var(--warn)'] else ['success', 'var(--ok)'] end -%>
      <div class="trow hover t-batches">
        <div class="stack">
          <%= bid_cell(b) %>
          <% if b.description -%><span class="batch-desc ellip"><%= description_html(b.description) %></span><% end -%>
          <% if b.parent_id -%><span class="small-mono ellip">parent <%= h(b.parent_id) %></span><% end -%>
        </div>
        <span class="pill" style="--tone:<%= tone %>"><%= status %></span>
        <div class="stack" style="gap:4px">
          <span class="mono" style="font-size:12px"><%= total.positive? ? (done * 100 / total).clamp(0, 100) : 0 %>% · <%= compact_number(done) %> / <%= compact_number(total) %></span>
          <div class="progress">
            <% if total.positive? -%>
              <i style="width:<%= (stats[:succeeded].to_i * 100.0 / total).round(2) %>%;background:<%= hue(b.bid) %>"></i>
              <% if failed.positive? -%><i style="width:<%= [failed * 100.0 / total, 0.6].max.round(2) %>%;background:var(--err)"></i><% end -%>
            <% end -%>
          </div>
        </div>
        <span class="num"><%= format_numbers(stats[:succeeded]) %></span>
        <span class="num" style="color:<%= failed.positive? ? 'var(--err)' : 'var(--faint)' %>"><%= format_numbers(failed) %></span>
        <span class="num"><%= format_numbers(stats[:pending]) %></span>
        <span class="mute"><%= b.created_at ? "#{elapsed(b.created_at)} ago" : '—' %></span>
      </div>
    <% end -%>
  </div></div></section>
<% else -%>
  <div class="batches">
    <% @page.batches.each do |b| -%>
      <% stats = b.stats -%>
      <% total = stats[:total].to_i -%>
      <% succeeded = stats[:succeeded].to_i -%>
      <% failed = stats[:failed].to_i -%>
      <% done = total - stats[:pending].to_i -%>
      <% status, tone = if !b.ready? then ['open', 'var(--acc)'] elsif failed.positive? then ['complete with failures', 'var(--warn)'] else ['success', 'var(--ok)'] end -%>
      <% callbacks = b.callbacks.compact -%>
      <section class="card batch">
        <div class="batch-top">
          <div class="stack" style="flex:1;gap:4px">
            <div><%= bid_cell(b) %></div>
            <div class="small-mono ellip">
              <% if b.parent_id -%>parent <%= h(b.parent_id) %> · <% end -%>started <%= b.created_at ? "#{elapsed(b.created_at)} ago" : '—' %>
            </div>
            <% if b.description -%><div class="batch-desc"><%= description_html(b.description) %></div><% end -%>
          </div>
          <span class="pill" style="--tone:<%= tone %>"><%= status %></span>
        </div>
        <div class="batch-pct">
          <b><%= total.positive? ? (done * 100 / total).clamp(0, 100) : 0 %>%</b>
          <span class="mono mute" style="font-size:11.5px"><%= compact_number(done) %> / <%= compact_number(total) %></span>
        </div>
        <div class="progress">
          <% if total.positive? -%>
            <i style="width:<%= (succeeded * 100.0 / total).round(2) %>%;background:<%= hue(b.bid) %>"></i>
            <% if failed.positive? -%><i style="width:<%= [failed * 100.0 / total, 0.6].max.round(2) %>%;background:var(--err)"></i><% end -%>
          <% end -%>
        </div>
        <div class="batch-foot">
          <span><span class="num" style="color:var(--ink)"><%= format_numbers(succeeded) %></span> succeeded</span>
          <span><span class="num" style="color:var(--err)"><%= format_numbers(failed) %></span> failed</span>
          <span><span class="num" style="color:var(--ink)"><%= format_numbers(stats[:pending]) %></span> pending</span>
          <% if callbacks.any? -%>
            <span class="cb">
              <% callbacks.each do |event, callback| -%><span>on_<%= event %> → <%= h(callback[:class]) %></span><% end -%>
            </span>
          <% end -%>
        </div>
      </section>
    <% end -%>
  </div>
<% end -%>
<% if @page.newer || @page.older -%>
  <nav class="pager">
    <% { newer: ['&larr; Newer', :after], older: ['Older &rarr;', :before] }.each do |dir, (label, param)| -%>
      <% if @page.public_send(dir) -%>
        <a class="btn quiet" hx-get="<%= url_for('/batches/_table', @query.merge(param => @page.public_send(dir))) %>" hx-target="#batches-panel" hx-swap="outerHTML" hx-indicator="#global-spinner"><%= label %></a>
      <% else -%>
        <span class="btn quiet disabled"><%= label %></span>
      <% end -%>
    <% end -%>
  </nav>
<% end -%>
</div>
