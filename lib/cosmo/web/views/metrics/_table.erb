<% selectable = @days > 1 -%>
<section class="card">
  <div class="card-head bar ruled">
    <div class="card-title">Job classes</div>
    <% if selectable -%><span class="small-mono">click a job to chart it</span><% end -%>
  </div>
  <div class="scroll"><div style="min-width:620px">
    <div class="thead t-metrics"><span>Job</span><span class="r">Runs</span><span class="r">Failed</span><span class="r">Avg execution</span><span class="r">Avg wait</span></div>
    <% @rows.each do |row| -%>
      <% selected = selectable && row[:job] == @job -%>
      <div class="trow hover t-metrics<%= ' selectable' if selectable %><%= ' selected' if selected %>"
           <% if selectable -%>
           hx-get="<%= url_for('/metrics/_panel', { days: @days, job: u(row[:job]) }) %>"
           hx-target="#metrics-panel" hx-swap="outerHTML" hx-indicator="#global-spinner"
           <% if selected -%>aria-selected="true"<% end -%>
           <% end -%>>
        <span class="mono ellip"><%= h(row[:job]) %></span>
        <span class="r"><%= format_numbers(row[:count]) %></span>
        <span class="r" style="color:<%= row[:failed].positive? ? 'var(--err)' : 'var(--faint)' %>"><%= format_numbers(row[:failed]) %></span>
        <span class="r mute"><%= duration(row[:exec_ms]) %></span>
        <span class="r mute"><%= duration(row[:wait_ms]) %></span>
      </div>
    <% end -%>
  </div></div>
</section>
