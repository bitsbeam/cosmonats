<div class="seg" style="align-self:flex-start">
  <% @ranges.each do |range, name| -%>
    <a class="<%= 'on' if @days == range %>" href="<%= url_for('/metrics', { days: range }) %>"><%= h(name) %></a>
  <% end -%>
</div>

<div id="metrics-panel" class="view" hx-get="<%= url_for('/metrics/_panel', { days: @days }) %>" hx-trigger="load" hx-swap="outerHTML">
  <section class="card"><div class="loading">Loading metrics&hellip;</div></section>
</div>
