<section class="card card-pad">
  <div class="card-head">
    <div class="card-title"><span class="mono"><%= h(@job) %></span> <span class="mute" style="font-size:13px">last <%= @days %> days</span></div>
    <div class="legend"><i class="bars"></i>runs / day</div>
    <div class="legend"><i class="line"></i>avg execution</div>
  </div>
  <% if @chart.empty? -%>
    <div class="empty"><b>No runs</b><code><%= h(@job) %></code> didn't run in this period.</div>
  <% else -%>
    <div class="chart dual">
      <div class="yaxis"><% @chart.ticks.each do |tick| -%><span><%= compact_number(tick[:count]) %></span><% end -%></div>
      <div class="plot-col">
        <div class="plot">
          <svg viewBox="0 0 <%= Cosmo::Web::Chart::WIDTH %> <%= Cosmo::Web::Chart::HEIGHT %>" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="runsFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--c1)" stop-opacity="0.55"/><stop offset="1" stop-color="var(--c1)" stop-opacity="0.18"/></linearGradient>
            </defs>
            <path d="<%= @chart.grid %>" stroke="var(--line)" stroke-width="1" vector-effect="non-scaling-stroke" fill="none"/>
            <path d="<%= @chart.bars %>" fill="url(#runsFill)"/>
            <path d="<%= @chart.line %>" stroke="var(--c4)" stroke-width="1.75" vector-effect="non-scaling-stroke" fill="none" stroke-linejoin="round"/>
          </svg>
          <% @chart.points.each do |point| -%>
            <% if point[:dot] -%><i class="pt" style="left:<%= point[:center] %>%;top:<%= point[:dot] %>%"></i><% end -%>
            <div class="hit band<%= ' flip' if point[:center] > 62 %>" style="left:<%= point[:left] %>%;width:<%= point[:width] %>%">
              <div class="hv-dot" style="top:<%= point[:dot] || point[:top] %>%;border-color:<%= point[:dot] ? 'var(--c4)' : 'var(--c1)' %>"></div>
              <div class="tip">
                <span class="mono mute" style="font-size:10.5px"><%= point[:label] %></span>
                <div><span class="mute">runs</span><span class="num"><%= format_numbers(point[:count]) %></span></div>
                <div><span class="mute">failed</span><span class="num" style="color:var(--err)"><%= format_numbers(point[:failed]) %></span></div>
                <div><span class="mute">avg exec</span><span class="num" style="color:var(--c4)"><%= duration(point[:exec_ms]) %></span></div>
                <div><span class="mute">avg wait</span><span class="num"><%= duration(point[:wait_ms]) %></span></div>
              </div>
            </div>
          <% end -%>
        </div>
        <div class="xaxis abs"><% @chart.labels.each do |label| -%><span style="left:<%= label[:left] %>%"><%= label[:text] %></span><% end -%></div>
      </div>
      <div class="yaxis right"><% @chart.ticks.each do |tick| -%><span><%= duration(tick[:exec_ms]) %></span><% end -%></div>
    </div>
  <% end -%>
</section>
