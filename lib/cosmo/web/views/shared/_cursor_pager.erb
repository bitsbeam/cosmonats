<% if @after || @next_after -%>
  <nav class="pager">
    <% if @after -%>
      <a class="btn quiet" hx-get="<%= url_for(@path, Hash(@query)) %>" hx-target="<%= @target %>" hx-swap="outerHTML" hx-indicator="#global-spinner">&laquo; First</a>
    <% else -%>
      <span class="btn quiet disabled">&laquo; First</span>
    <% end -%>
    <% if @next_after -%>
      <a class="btn quiet" hx-get="<%= url_for(@path, Hash(@query).merge(after: @next_after)) %>" hx-target="<%= @target %>" hx-swap="outerHTML" hx-indicator="#global-spinner" hx-push-url="true">Next &rarr;</a>
    <% else -%>
      <span class="btn quiet disabled">Next &rarr;</span>
    <% end -%>
  </nav>
<% end -%>
