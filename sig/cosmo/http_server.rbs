module Cosmo
  class HTTPServer
    DEFAULT_HOST: String
    NOT_FOUND: [Integer, Hash[String, String], Array[String]]

    @app: untyped
    @host: String
    @port: Integer
    @server: untyped
    @thread: Thread?

    def self.app: () -> untyped

    def initialize: (?untyped app, port: Integer, ?host: String) -> void

    def start: () -> self

    def stop: () -> void

    def port: () -> Integer
  end
end
