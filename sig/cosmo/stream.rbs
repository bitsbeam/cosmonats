module Cosmo
  module Stream
    def self.included: (Class base) -> void

    module ClassMethods
      @default_options: Hash[Symbol, untyped]

      def options: (
        ?stream: (Symbol | ::String)?,
        ?consumer_name: ::String?,
        ?batch_size: Integer?,
        ?fetch_timeout: (Integer | Float)?,
        ?start_position: (Symbol | ::String | Time)?,
        ?consumer: Hash[Symbol, untyped]?,
        ?publisher: Hash[Symbol, untyped]?
      ) -> Hash[Symbol, untyped]
      alias cosmo_options options

      def publish: (untyped data, ?subject: ::String?, **untyped options) -> untyped

      def default_options: () -> Hash[Symbol, untyped]

      def register: () -> void
    end

    def process: (Array[Message] messages) -> void

    def process_batch: (Array[Message] messages) -> void

    def process_many: (Array[Message] messages) -> void

    def process_one: () -> void

    def logger: () -> untyped

    def message: () -> Message?

    def publish: (untyped data, ::String? subject, **untyped options) -> untyped
  end
end
