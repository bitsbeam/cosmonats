module Cosmo
  module API
    class Cron
      STREAM: ::String

      self.@instance: Cron
      @client: Client

      def self.instance: () -> Cron

      def all: () -> ::Array[Hash[Symbol, untyped]]

      def upsert!: (?class_name: ::String?,
                    ?stream: ::String?,
                    ?schedule: ::String?,
                    ?args: ::Array[untyped],
                    ?timezone: ::String?,
                    ?name: (::String | ::Symbol)?) -> Hash[Symbol, untyped]?

      def delete!: (::String subject) -> void

      def run_now!: (::String schedule_subject) -> void

      private

      def client: () -> Client
      def schedules: () -> ::Array[Hash[Symbol, untyped]]
      def build_from_nats: (::String subject) -> Hash[Symbol, untyped]?
      def name_from_subject: (::String subject) -> ::String?
    end
  end
end
