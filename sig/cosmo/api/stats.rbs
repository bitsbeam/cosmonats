module Cosmo
  module API
    module Stats
      def self.summary: () -> Hash[Symbol, ::Integer]

      def self.processed: () -> ::Integer

      def self.failed: () -> ::Integer

      def self.busy: () -> ::Integer

      def self.enqueued: (?Array[Stream] streams) -> ::Integer

      def self.retries: (?Array[Stream] streams) -> ::Integer

      def self.scheduled: () -> ::Integer

      def self.dead: () -> ::Integer

      def self.queues: () -> Array[Hash[Symbol, untyped]]

      def self.queue: (Stream stream, ?Hash[::String, ::Integer] busy) -> Hash[Symbol, untyped]
    end
  end
end
