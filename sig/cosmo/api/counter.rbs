module Cosmo
  module API
    class Counter
      @namespace: ::String
      @client: Client

      def self.setup!: () -> void

      def self.stream_config: () -> Hash[Symbol, untyped]

      def initialize: (::String namespace) -> void

      def increment!: (Symbol | ::String key, ?by: ::Integer, ?msg_id: ::String?) -> ::Integer?
      alias incr! increment!

      def increment: (Symbol | ::String key, ?by: ::Integer, ?msg_id: ::String?) -> ::Integer?
      alias incr increment

      def decrement!: (Symbol | ::String key, ?by: ::Integer, ?msg_id: ::String?) -> ::Integer?
      alias decr! decrement!

      def decrement: (Symbol | ::String key, ?by: ::Integer, ?msg_id: ::String?) -> ::Integer?
      alias decr decrement

      def reset: (Symbol | ::String key) -> ::Integer?
      alias purge reset

      def get: (Symbol | ::String key) -> ::Integer

      private

      def safely: [T] (Symbol | ::String key) { () -> T } -> T?

      def publish: (Symbol | ::String key, ::String value, ?msg_id: ::String?) -> ::Integer?

      def subject: (Symbol | ::String key) -> ::String

      def client: () -> Client
    end
  end
end
