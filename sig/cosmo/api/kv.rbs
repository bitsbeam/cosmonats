module Cosmo
  module API
    class KV
      LIMIT: ::Integer

      @name: ::String
      @options: Hash[Symbol, untyped]
      @kv: untyped
      @direct: true

      attr_reader kv: untyped

      def initialize: (::String name, ?Hash[Symbol, untyped]? options) -> void

      def set: (::String | ::Integer key, untyped value, ?ttl: ::Integer?) -> ::Integer

      def get: (::String | ::Integer key) -> untyped

      def create: (::String | ::Integer key, untyped value) -> ::Integer

      def delete: (::String | ::Integer key) -> ::Integer

      def keys: (?::String? subject, ?limit: ::Integer?, ?offset: ::Integer) -> Array[::String]

      def entries: (?::String? subject, ?limit: ::Integer?, ?offset: ::Integer) -> Array[[::String, ::String]]

      def direct_entries: (?::String? subject, ?limit: ::Integer?) -> Array[[::String, ::String]]

      def direct_count: (?::String? subject) -> ::Integer

      def direct_keys: (?::String? subject) -> Array[::String]

      def direct_values: (Array[::String] keys) -> Hash[::String, ::String]

      def write_many: (Hash[::String, untyped] pairs, ?ttl: ::Integer?) -> void

      def direct!: () -> true

      def purge: (::String | ::Integer key) -> untyped

      def erase: (::String | ::Integer key) -> ::Integer?

      def clean: () -> ::Integer?

      def count: () -> ::Integer
      alias size count

      private

      def walk: (::String? subject, limit: ::Integer?, offset: ::Integer, meta_only: bool) -> Array[[::String, ::String]]

      def drained?: (untyped watcher, ::Integer seen) -> bool

      def publish_cas: (::String | ::Integer key, ::String value, ::Integer ttl, last_seq: ::Integer) -> untyped

      def client: () -> Client
    end
  end
end
