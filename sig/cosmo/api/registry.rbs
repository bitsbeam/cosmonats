module Cosmo
  module API
    class Registry
      LIMIT: ::Integer
      KEYS_TTL: ::Integer

      self.@instance: Registry
      @kv: KV
      @keys_mutex: Mutex
      @keys: Array[::String]
      @keys_at: Float

      def self.instance: () -> instance

      def self.token: (untyped value) -> ::String

      def initialize: () -> void

      def put: (::String | ::Integer key, Hash[Symbol, untyped] value) -> void

      def put_many: (Hash[::String, Hash[Symbol, untyped]] entries) -> void

      def remove: (::String | ::Integer key) -> void

      def list: (?page: ::Integer?, ?limit: ::Integer) -> Array[Hash[Symbol, untyped]]

      def all: () -> Array[Hash[Symbol, untyped]]

      def size: () -> ::Integer

      private

      def keys: () -> Array[::String]

      def bucket: () -> KV

      def sanitize: (::String | ::Integer key) -> ::String
    end
  end
end
