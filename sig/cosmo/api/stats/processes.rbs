module Cosmo
  module API
    module Stats
      class Processes < Registry
        TTL: ::Integer
        BUCKET: ::String
        KINDS: Array[::String]

        @registered: Hash[::String, ::String]

        def self.kind: (Hash[Symbol, untyped] process) -> ::String

        def initialize: () -> void

        def threads: () -> ::Integer

        def register: (::String identity, Hash[Symbol, untyped] info) -> void

        def unregister: (::String identity) -> void

        private

        def key_for: (::String identity, Hash[Symbol, untyped] info) -> ::String
      end
    end
  end
end
