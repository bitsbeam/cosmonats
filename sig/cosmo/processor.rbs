module Cosmo
  class Processor
    STREAM_PAUSED_RECHECK_TTL: ::String
    STREAMS_PAUSED_IDLE_SLEEP: ::String
    STREAM_EMPTY_BACKOFF_MAX: ::String
    QUIET_SLEEP: ::String

    @pool: Utils::ThreadPool
    @running: untyped
    @quiet: untyped
    @consumers: Array[untyped]
    @threads: Array[Thread]
    @cache: Utils::TTLCache
    @busy: untyped
    @in_flight: untyped
    @options: Hash[Symbol, untyped]
    @consumer_state: untyped

    def self.run: (*untyped) -> Processor

    def self.validate_options!: (Hash[Symbol, untyped] options) -> void

    attr_reader consumers: Array[untyped]

    def initialize: (Utils::ThreadPool pool, untyped running, Hash[Symbol, untyped] options, quiet: untyped) -> void

    def run: () -> void

    def busy: () -> Integer

    def release: () -> Integer

    def touch: () -> void

    def interrupt: (::Integer | ::Float timeout) -> void

    def stop: (?::Integer | ::Float timeout) -> void

    private

    def run_loop: () -> void

    def work_loop: () -> void

    def schedule_loop: () -> void

    def scheduler?: () -> bool

    def setup: () -> void

    def process: (*untyped) -> void

    def fetch_timeout: (Hash[Symbol, untyped] config) -> Float

    def fetch_subjects: (Hash[Symbol, untyped] config) -> untyped

    def track_busy: [T] (Array[untyped] messages) { () -> T } -> T

    def release_message: (untyped message) -> bool

    def abandon: (untyped message) -> void

    def running?: () -> bool

    def quiet?: () -> bool

    def fetch: (untyped subscription, batch_size: Integer?, timeout: Numeric) -> Array[untyped]?

    def client: () -> Client

    def stopwatch: () -> Utils::Stopwatch

    def consumer_state: () -> untyped

    def backoff_key: (Hash[Symbol, untyped] config) -> String
  end
end
